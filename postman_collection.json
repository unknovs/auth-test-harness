		{
			"name": "Identity list: Code Step",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('back to the client with a code', () => pm.response.to.have.status(302));",
							"const loc = pm.response.headers.get('Location');",
							"const m = loc && loc.match(/[?&]code=([^&]+)/);",
							"if (m) { pm.collectionVariables.set('list_auth_code', decodeURIComponent(m[1])); }"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
